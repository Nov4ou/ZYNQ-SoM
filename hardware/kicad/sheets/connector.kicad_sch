	(text_box "CARRIER REQUIREMENT:\nJ403.16 = PUDC_B / PL_B34_IO3_P.\nCarrier MUST tie this pin to +VCCIO_34 or GND with <=1k.\nDo not leave PUDC_B floating during configuration."
		(exclude_from_sim no)
		(at 34.29 156.9445 0)
